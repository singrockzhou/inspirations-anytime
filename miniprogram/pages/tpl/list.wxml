<view class="page">

  <view class="head">
    <view class="lead">{{leadText}}</view>
    <!-- 条数已经写进导语（「25 个写作与记录模板…」），这里只留英文界面那句
         「模板内容是中文的」。原来这里还有一行「25 个模板」，与导语重复，
         两行相隔 14rpx 各说一遍同一个数字，看着像没对上的两处数据 -->
    <view class="meta" wx:if="{{showCnNote}}">{{t.cn_only}}</view>
  </view>

  <!-- 按分类分组。默认全展开（open: true），25 条一次给全；
       每组仍保留「收起」，读长页的人可以手动折叠。
       这里刻意用 hidden 而不是 wx:if：wx:if 会把节点从渲染结果里摘掉，
       收起后条目连链接都不存在了；hidden 只是 display:none，节点还在。
       爬虫认不认 display:none 里的链接，官方没有说明——这是推断。 -->
  <view class="group" wx:for="{{groups}}" wx:key="id" wx:for-item="g" wx:for-index="idx">
    <view class="g-head">
      <view class="g-top">
        <text class="g-name">{{g.name}}</text>
        <text class="g-n">{{g.countText}}</text>
      </view>
      <view class="g-desc">{{g.desc}}</view>
    </view>

    <view class="items">
      <navigator
        class="item"
        wx:for="{{g.head}}"
        wx:key="id"
        wx:for-item="it"
        url="/pages/tpl/detail?k={{it.id}}"
        hover-class="item-hover"
        hover-stay-time="60"
      >
        <view class="it-main">
          <text class="it-title">{{it.title}}</text>
          <view class="it-scene">{{it.scene}}</view>
        </view>
        <text class="it-go">›</text>
      </navigator>

      <view class="more" hidden="{{!g.open}}">
        <navigator
          class="item"
          wx:for="{{g.more}}"
          wx:key="id"
          wx:for-item="it"
          url="/pages/tpl/detail?k={{it.id}}"
          hover-class="item-hover"
          hover-stay-time="60"
        >
          <view class="it-main">
            <text class="it-title">{{it.title}}</text>
            <view class="it-scene">{{it.scene}}</view>
          </view>
          <text class="it-go">›</text>
        </navigator>
      </view>

      <!-- 展开 / 收起。整行都是可点区，不做成一个小箭头 -->
      <view
        class="more-btn"
        wx:if="{{g.more.length}}"
        data-idx="{{idx}}"
        catchtap="onToggle"
        hover-class="more-hover"
      >
        <text class="more-t">{{g.open ? t.collapse : g.moreText}}</text>
        <text class="more-ico {{g.open ? 'up' : ''}}">›</text>
      </view>
    </view>
  </view>

  <view class="foot">
    <view class="foot-line">{{t.start_hint}}</view>
    <navigator class="foot-link" url="/pages/guide/guide" hover-class="tap-dim">{{guideText}} →</navigator>
  </view>

  <!-- 第一次从搜索结果或分享卡片落地的人，看到的是「一页模板」而不是「一个产品」。
       一行小字补上名字与定位，就够了，不做页脚大块 -->
  <view class="brand">{{t.brand}}</view>

</view>
