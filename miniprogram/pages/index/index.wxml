<view class="page">

  <view class="top">
    <view class="top-left">
      <text class="title">{{t.title}}</text>
      <text class="count" wx:if="{{total > 0}}">{{countText}}</text>
    </view>
    <view class="top-right">
      <!-- 从聊天存一条：原在「我的」页，挪到首页后一眼能看到 -->
      <text class="collect" catchtap="onCollect">{{t.collect}}</text>
      <text class="top-act" catchtap="toggleSelect">{{selectMode ? t.cancel : t.select}}</text>
      <view class="mine" catchtap="goMe">{{t.mine}}</view>
    </view>
  </view>

  <!-- 吸顶：伪输入条 + 搜索入口。一次点击分别进入"写"和"找" -->
  <view class="stick">
    <view class="composer" catchtap="goText">
      <text class="composer-ph">{{t.composer}}</text>
      <view class="composer-dot">✎</view>
    </view>
    <view class="sbtn" hover-class="sbtn-hover" hover-stay-time="80" catchtap="goSearch">
      <view class="s-glass"></view>
      <view class="s-handle"></view>
    </view>
  </view>

  <!-- 筛选：全部 / 星标 / 归档 / 标签 -->
  <scroll-view class="chips" scroll-x="true" enable-flex="true" show-scrollbar="{{false}}">
    <view class="chip {{filter === 'all' && !filterTag ? 'on' : ''}}" data-mode="all" catchtap="onFilter">
      {{t.chip_all}}<text class="chip-n">{{counts.all}}</text>
    </view>
    <view class="chip {{filter === 'star' ? 'on' : ''}}" data-mode="star" catchtap="onFilter">
      <text class="chip-star">★</text>{{t.chip_star}}<text class="chip-n">{{counts.star}}</text>
    </view>
    <view class="chip {{filter === 'archive' ? 'on' : ''}}" data-mode="archive" catchtap="onFilter">
      {{t.chip_archive}}<text class="chip-n">{{counts.archive}}</text>
    </view>
    <view
      class="chip chip-tag {{filterTag === item.tag ? 'on' : ''}}"
      wx:for="{{tags}}"
      wx:key="tag"
      wx:for-item="item"
      data-tag="{{item.tag}}"
      catchtap="onFilterTag"
    >#{{item.tag}}<text class="chip-n">{{item.count}}</text></view>
  </scroll-view>

  <!--
    备份提示：记录只在微信给小程序分的沙箱里，删掉小程序、清理微信存储、
    换手机都会一起清掉，而且没有云端副本可恢复。攒够条数、或久没备份时
    在这里提一条：点整条直接导出，按 × 静默 7 天。做成细横幅而不是弹窗，
    是因为它不该有打断成本——看得见、点一下就能处理掉，不处理也不拦路。
  -->
  <view class="bk" wx:if="{{backup}}" catchtap="onBackup">
    <view class="bk-main">
      <text class="bk-text">{{backup.text}}</text>
      <text class="bk-tip">{{backup.tip}}</text>
    </view>
    <view class="bk-x" catchtap="onBackupClose"><text class="bk-xc">×</text></view>
  </view>

  <!--
    筛选条下面这一栏只放一样东西，优先级从高到低：
    今天还没记 → 那年今日 → 随便翻一条。
    提醒排在最前，是因为它会在记完之后自己消失，不会长期占着这栏。
  -->
  <view class="anni nudge" wx:if="{{nudge}}" catchtap="onNudge">
    <view class="anni-top">
      <text class="anni-label">{{nudge.label}}</text>
      <text class="anni-tip">{{nudge.tip}}</text>
    </view>
    <view class="anni-text">{{nudge.text}}</view>
  </view>
  <view class="anni" wx:elif="{{anniversary}}" catchtap="openAnniversary">
    <view class="anni-top">
      <text class="anni-label">{{anniversary.label}}</text>
      <text class="anni-tip">{{t.anni_open}}</text>
    </view>
    <view class="anni-text">{{anniversary.text}}</view>
  </view>
  <view
    class="anni review"
    wx:elif="{{reviewTotal > 1 && filter === 'all' && !filterTag}}"
    catchtap="openReview"
  >
    <view class="anni-top">
      <text class="anni-label">{{t.review_label}}</text>
      <text class="anni-tip">{{reviewTip}}</text>
    </view>
    <view class="anni-text">{{t.review_text}}</view>
  </view>

  <!-- 今天平铺 / 非今天按周、月、年堆叠 -->
  <view class="feed" wx:if="{{!empty}}">
    <block wx:for="{{groups}}" wx:key="key" wx:for-item="g">

      <!-- ========== 今天：完整卡片平铺，每条可左滑删除 ========== -->
      <block wx:if="{{g.today}}">
        <view class="grp">{{t.grp_today}}</view>
        <view class="flat" wx:for="{{g.items}}" wx:key="id" wx:for-item="it">
          <swipe-cell
            item-id="{{it.id}}"
            open="{{openSwipeId === it.id}}"
            disabled="{{selectMode}}"
            bind:open="onSwipeOpen"
            bind:close="onSwipeClose"
            bind:delete="onSwipeDelete"
          >
            <card
              item="{{it}}"
              playing="{{playingId === it.id}}"
              highlight="{{highlightId === it.id}}"
              select-mode="{{selectMode}}"
              checked="{{it._checked}}"
              bind:open="onCardOpen"
              bind:action="onCardAction"
              bind:toggle="onCardToggle"
              bind:play="onPlay"
              bind:preview="onPreview"
            />
          </swipe-cell>
        </view>
      </block>

      <!-- ========== 本周 / 本月 / 今年 / 往年：堆叠组 ========== -->
      <view class="group" wx:else>
        <view class="ghead">
          <view class="gleft" catchtap="onToggle" data-key="{{g.key}}">
            <text class="glabel {{g.kind === 'past' ? 'dim' : ''}}">{{g.label}}</text>
            <text class="gcount">{{g.countText}}</text>
          </view>
          <view class="gright">
            <text class="gtoggle" catchtap="onToggle" data-key="{{g.key}}">{{g.open ? t.collapse : t.expand}}</text>
            <text class="gdel" catchtap="onDeleteGroup" data-key="{{g.key}}">{{t.group_delete}}</text>
          </view>
        </view>

        <!-- 折叠态：三张错落的卡片边缘，最上面一张露出摘要 -->
        <view class="stack" wx:if="{{!g.open}}" catchtap="onToggle" data-key="{{g.key}}">
          <view class="layer layer-3"></view>
          <view class="layer layer-2"></view>
          <view class="layer layer-1">
            <view class="peek-head">
              <text class="peek-badge">{{g.items[0]._badge}}</text>
              <text class="peek-time">{{g.items[0]._time}}</text>
            </view>
            <view class="peek-line">{{g.items[0]._peek}}</view>
          </view>
          <view class="stack-more" wx:if="{{g.count > 1}}">{{g.moreText}}</view>
        </view>

        <!-- 展开态：完整列表，同样支持左滑删除单条 -->
        <view class="gbody" wx:else>
          <view class="flat" wx:for="{{g.items}}" wx:key="id" wx:for-item="it">
            <swipe-cell
              item-id="{{it.id}}"
              open="{{openSwipeId === it.id}}"
              disabled="{{selectMode}}"
              bind:open="onSwipeOpen"
              bind:close="onSwipeClose"
              bind:delete="onSwipeDelete"
            >
              <card
                item="{{it}}"
                playing="{{playingId === it.id}}"
                highlight="{{highlightId === it.id}}"
                select-mode="{{selectMode}}"
                checked="{{it._checked}}"
                bind:open="onCardOpen"
                bind:action="onCardAction"
                bind:toggle="onCardToggle"
                bind:play="onPlay"
                bind:preview="onPreview"
              />
            </swipe-cell>
          </view>
        </view>
      </view>
    </block>

    <view class="more-hint" wx:if="{{hasMore}}">{{t.more_hint}}</view>
    <view class="end-hint" wx:else>{{t.end_hint}}</view>
  </view>

  <!-- 空态：一句话 + 直接可点的入口，不放插画 -->
  <view class="empty" wx:if="{{empty && !loading}}">
    <view class="empty-line">{{emptyText}}</view>
    <view class="empty-sub">{{emptySub}}</view>
    <view class="empty-btn" wx:if="{{filter === 'all' && !filterTag}}" catchtap="goText">{{t.empty_btn_first}}</view>
    <view class="empty-btn" wx:else catchtap="onFilter" data-mode="all">{{t.empty_btn_all}}</view>
    <view class="empty-link" wx:if="{{filter === 'all' && !filterTag}}" catchtap="onCollect">{{t.empty_link}}</view>
  </view>

  <!-- 多选操作条 -->
  <view class="selbar" wx:if="{{selectMode}}">
    <text class="sel-count">{{selCountText}}</text>
    <view class="sel-act" catchtap="onSelCopy">{{t.sel_copy}}</view>
    <view class="sel-act" catchtap="onSelExport">{{t.sel_export}}</view>
    <view class="sel-act danger" catchtap="onSelDelete">{{t.sel_delete}}</view>
  </view>

  <!-- 底部三入口并排：点一下直接进，不再有 + 号的两级菜单 -->
  <view class="entry-bar" wx:if="{{!selectMode}}">
    <view class="entry" hover-class="entry-hover" hover-stay-time="80" catchtap="goText">
      <view class="entry-ic ic-text">
        <view class="ln ln-a"></view>
        <view class="ln ln-b"></view>
        <view class="ln ln-c"></view>
      </view>
      <text class="entry-tx">{{t.entry_text}}</text>
    </view>

    <view class="entry" hover-class="entry-hover" hover-stay-time="80" catchtap="goVoice">
      <view class="entry-ic ic-voice">
        <view class="bar bar-a"></view>
        <view class="bar bar-b"></view>
        <view class="bar bar-c"></view>
      </view>
      <text class="entry-tx">{{t.entry_voice}}</text>
    </view>

    <view class="entry entry-key" hover-class="entry-hover-key" hover-stay-time="80" catchtap="goPhoto">
      <view class="entry-ic ic-cam">
        <view class="cam-top"></view>
        <view class="cam-body">
          <view class="cam-lens"></view>
        </view>
      </view>
      <text class="entry-tx">{{t.entry_photo}}</text>
    </view>
  </view>

  <!-- 删除后的撤销条（单条或整组共用） -->
  <view class="undo" wx:if="{{undo.visible}}">
    <text class="undo-text">{{undo.text}}</text>
    <view class="undo-btn" catchtap="onUndo">{{t.undo_btn}}</view>
  </view>

  <action-sheet
    visible="{{sheet.visible}}"
    title="{{sheet.title}}"
    items="{{sheet.items}}"
    bind:select="onSheetSelect"
    bind:close="closeSheet"
  />

  <view class="toast" wx:if="{{toastText}}">{{toastText}}</view>

</view>

<!-- 统一对话框：页面内只挂一个，命令式调用见 utils/dialog.js -->
<dialog-view />
