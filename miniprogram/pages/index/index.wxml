<view class="page">

  <view class="top">
    <view class="top-left">
      <text class="title">我的灵感</text>
      <text class="count" wx:if="{{total > 0}}">{{total}} 条</text>
    </view>
    <view class="mine" catchtap="goMe">我的</view>
  </view>

  <!-- 吸顶伪输入条：1 次点击进入输入态 -->
  <view class="stick">
    <view class="composer" catchtap="goText">
      <text class="composer-ph">今天想到什么？</text>
      <view class="composer-dot">✎</view>
    </view>
  </view>

  <!-- 今天平铺 / 非今天按周、月、年堆叠 -->
  <view class="feed" wx:if="{{!empty}}">
    <block wx:for="{{groups}}" wx:key="key" wx:for-item="g">

      <!-- ========== 今天：完整卡片平铺，每条可左滑删除 ========== -->
      <block wx:if="{{g.today}}">
        <view class="grp">今天</view>
        <view class="flat" wx:for="{{g.items}}" wx:key="id" wx:for-item="it">
          <swipe-cell
            item-id="{{it.id}}"
            open="{{openSwipeId === it.id}}"
            bind:open="onSwipeOpen"
            bind:close="onSwipeClose"
            bind:delete="onSwipeDelete"
          >
            <card
              item="{{it}}"
              playing="{{playingId === it.id}}"
              highlight="{{highlightId === it.id}}"
              bind:open="onCardOpen"
              bind:action="onCardAction"
              bind:play="onPlay"
              bind:preview="onPreview"
            />
          </swipe-cell>
        </view>
      </block>

      <!-- ========== 本周 / 本月 / 今年 / 往年：堆叠组 ========== -->
      <view class="group" wx:else>
        <view class="ghead">
          <view class="gleft" catchtap="onToggle" data-key="{{g.key}}">
            <text class="glabel {{g.kind === 'past' ? 'dim' : ''}}">{{g.label}}</text>
            <text class="gcount">{{g.count}} 条</text>
          </view>
          <view class="gright">
            <text class="gtoggle" catchtap="onToggle" data-key="{{g.key}}">{{g.open ? '收起' : '展开'}}</text>
            <text class="gdel" catchtap="onDeleteGroup" data-key="{{g.key}}">删整组</text>
          </view>
        </view>

        <!-- 折叠态：三张错落的卡片边缘，最上面一张露出摘要 -->
        <view class="stack" wx:if="{{!g.open}}" catchtap="onToggle" data-key="{{g.key}}">
          <view class="layer layer-3"></view>
          <view class="layer layer-2"></view>
          <view class="layer layer-1">
            <view class="peek-head">
              <text class="peek-badge">{{g.items[0]._badge}}</text>
              <text class="peek-time">{{g.items[0]._time}}</text>
            </view>
            <view class="peek-line">{{g.items[0]._peek}}</view>
          </view>
          <view class="stack-more" wx:if="{{g.count > 1}}">还有 {{g.count - 1}} 条</view>
        </view>

        <!-- 展开态：完整列表，同样支持左滑删除单条 -->
        <view class="gbody" wx:else>
          <view class="flat" wx:for="{{g.items}}" wx:key="id" wx:for-item="it">
            <swipe-cell
              item-id="{{it.id}}"
              open="{{openSwipeId === it.id}}"
              bind:open="onSwipeOpen"
              bind:close="onSwipeClose"
              bind:delete="onSwipeDelete"
            >
              <card
                item="{{it}}"
                playing="{{playingId === it.id}}"
                highlight="{{highlightId === it.id}}"
                bind:open="onCardOpen"
                bind:action="onCardAction"
                bind:play="onPlay"
                bind:preview="onPreview"
              />
            </swipe-cell>
          </view>
        </view>
      </view>
    </block>

    <view class="more-hint" wx:if="{{hasMore}}">继续往下滑</view>
    <view class="end-hint" wx:else>到底了 · 左滑删一条，长按还能改</view>
  </view>

  <!-- 空态：一句话 + 直接可点的入口，不放插画 -->
  <view class="empty" wx:if="{{empty && !loading}}">
    <view class="empty-line">想到什么，就说一句</view>
    <view class="empty-sub">不用起标题，也不用选分类</view>
    <view class="empty-btn" catchtap="goText">记下第一条</view>
  </view>

  <!-- 底部三入口并排：点一下直接进，不再有 + 号的两级菜单 -->
  <view class="entry-bar">
    <view class="entry" hover-class="entry-hover" hover-stay-time="80" catchtap="goText">
      <view class="entry-ic ic-text">
        <view class="ln ln-a"></view>
        <view class="ln ln-b"></view>
        <view class="ln ln-c"></view>
      </view>
      <text class="entry-tx">写一句</text>
    </view>

    <view class="entry" hover-class="entry-hover" hover-stay-time="80" catchtap="goVoice">
      <view class="entry-ic ic-voice">
        <view class="bar bar-a"></view>
        <view class="bar bar-b"></view>
        <view class="bar bar-c"></view>
      </view>
      <text class="entry-tx">说一段</text>
    </view>

    <view class="entry entry-key" hover-class="entry-hover-key" hover-stay-time="80" catchtap="goPhoto">
      <view class="entry-ic ic-cam">
        <view class="cam-top"></view>
        <view class="cam-body">
          <view class="cam-lens"></view>
        </view>
      </view>
      <text class="entry-tx">拍一张</text>
    </view>
  </view>

  <!-- 删除后的撤销条（单条或整组共用） -->
  <view class="undo" wx:if="{{undo.visible}}">
    <text class="undo-text">{{undo.label}} · {{undo.left}} 秒内可以撤回</text>
    <view class="undo-btn" catchtap="onUndo">撤回</view>
  </view>

  <action-sheet
    visible="{{sheet.visible}}"
    title="{{sheet.title}}"
    items="{{sheet.items}}"
    bind:select="onSheetSelect"
    bind:close="closeSheet"
  />

  <view class="toast" wx:if="{{toastText}}">{{toastText}}</view>

</view>
