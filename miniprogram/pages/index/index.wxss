.page {
  min-height: 100vh;
  padding: 8rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
}

/* 顶部标题行 */
.top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 16rpx 4rpx 20rpx;
}

.top-left {
  display: flex;
  align-items: baseline;
}

.title {
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  color: var(--ink, #2c2723);
}

.count {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--ink-2, #8b8178);
}

.top-right {
  display: flex;
  align-items: center;
}

.top-act {
  font-size: 26rpx;
  color: var(--ink-2, #8b8178);
  padding: 8rpx 4rpx 8rpx 24rpx;
}

/* 从聊天存一条：同级的文字入口，只是用主色 + 稍重字重把动作点出来 */
.collect {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--accent, #c4713f);
  padding: 8rpx 4rpx 8rpx 24rpx;
}

.mine {
  font-size: 26rpx;
  color: var(--ink-2, #8b8178);
  padding: 8rpx 4rpx 8rpx 24rpx;
}

/* 吸顶：伪输入条 + 搜索按钮 */
.stick {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 4rpx 0 18rpx;
  background: var(--bg, #fbf8f3);
}

/* 纯 CSS 画的放大镜，避免为一个图标引入图片资源 */
.sbtn {
  position: relative;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-left: 16rpx;
  border-radius: 44rpx;
  background: var(--beige, #f7f1e7);
  border: 1rpx solid #f0e5d6;
}

.sbtn-hover {
  background: #f3ebde;
}

.s-glass {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid #a2957f;
  border-radius: 50%;
  box-sizing: border-box;
}

.s-handle {
  position: absolute;
  left: 46rpx;
  top: 50rpx;
  width: 16rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #a2957f;
  transform: rotate(45deg);
  transform-origin: left center;
}

.composer {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 44rpx;
  background: var(--beige, #f7f1e7);
  border: 1rpx solid #f0e5d6;
}

.composer:active {
  background: #f3ebde;
}

.composer-ph {
  font-size: 30rpx;
  color: #a2957f;
}

.composer-dot {
  font-size: 28rpx;
  color: var(--accent, #c4713f);
  opacity: 0.75;
}

/* 分组 */
.grp {
  padding: 20rpx 4rpx 14rpx;
  font-size: 24rpx;
  color: var(--ink-2, #8b8178);
  letter-spacing: 1rpx;
}

.more-hint,
.end-hint {
  padding: 12rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b3a795;
}

/* 空态 */
.empty {
  padding-top: 180rpx;
  text-align: center;
}

.empty-line {
  font-size: 36rpx;
  color: var(--ink, #2c2723);
  letter-spacing: 1rpx;
}

.empty-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--ink-2, #8b8178);
}

.empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  height: 88rpx;
  padding: 0 56rpx;
  border-radius: 44rpx;
  background: var(--accent, #c4713f);
  color: #fff;
  font-size: 30rpx;
}

.empty-btn:active {
  opacity: 0.88;
}

/* 空态的第二条路：不是主按钮，用文字链，不跟"记下第一条"抢 */
.empty-link {
  margin-top: 28rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: var(--ink-2, #8b8178);
}

/* 底部三入口：等宽并排，点一下直接进 */
.entry-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: stretch;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--bg, #fbf8f3);
  border-top: 1rpx solid var(--line, #f0e7da);
}

.entry {
  flex: 1;
  height: 116rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid #f1e8db;
  box-shadow: 0 2rpx 10rpx rgba(44, 39, 35, 0.03);
  transition: transform 0.12s ease, background-color 0.12s ease;
}

/* 用 margin 而不是 gap，低版本基础库也能吃住 */
.entry + .entry {
  margin-left: 18rpx;
}

.entry-hover {
  background: #fdf4ec;
  border-color: #f0d8c3;
  transform: scale(0.97);
}

/* 拍一张是主路径，给一点颜色权重 */
.entry-key {
  background: #fdf3ea;
  border-color: #f3ddc8;
}

.entry-key .entry-tx,
.entry-key .entry-ic {
  color: var(--accent, #c4713f);
}

.entry-hover-key {
  background: #fbe9da;
  border-color: #ecc9ab;
  transform: scale(0.97);
}

.entry-ic {
  width: 48rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-light, #d0895c);
}

.entry-tx {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1;
  letter-spacing: 1rpx;
  color: var(--ink-2, #8b8178);
}

/* 图标全部用 CSS 画，不额外引图片资源 */

/* 写一句：三行字 */
.ic-text {
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding-left: 5rpx;
}

.ic-text .ln {
  height: 4rpx;
  background: currentColor;
  border-radius: 3rpx;
}

.ln-a {
  width: 38rpx;
}

.ln-b {
  width: 38rpx;
  margin: 9rpx 0;
}

.ln-c {
  width: 24rpx;
}

/* 说一段：三根波形 */
.ic-voice {
  flex-direction: row;
}

.ic-voice .bar {
  width: 4rpx;
  margin: 0 4rpx;
  background: currentColor;
  border-radius: 3rpx;
}

.bar-a {
  height: 16rpx;
}

.bar-b {
  height: 34rpx;
}

.bar-c {
  height: 24rpx;
}

/* 拍一张：相机 */
.ic-cam {
  position: relative;
}

.cam-top {
  position: absolute;
  top: 2rpx;
  left: 50%;
  margin-left: -10rpx;
  width: 20rpx;
  height: 6rpx;
  background: currentColor;
  border-radius: 3rpx 3rpx 0 0;
}

.cam-body {
  position: absolute;
  top: 8rpx;
  left: 0;
  box-sizing: border-box;
  width: 48rpx;
  height: 34rpx;
  border: 4rpx solid currentColor;
  border-radius: 9rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cam-lens {
  box-sizing: border-box;
  width: 15rpx;
  height: 15rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

/* 撤销条：浮在入口条之上 */
.undo {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  height: 104rpx;
  padding: 0 12rpx 0 32rpx;
  border-radius: 24rpx;
  background: rgba(44, 39, 35, 0.92);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 60;
  animation: undo-in 0.2s ease-out;
}

@keyframes undo-in {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.undo-text {
  font-size: 26rpx;
  color: #f6efe4;
}

.undo-btn {
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  color: var(--accent-light, #e0a472);
  font-size: 28rpx;
}

.undo-btn:active {
  background: rgba(255, 255, 255, 0.08);
}

/* ================= 周 / 月 / 年 分组 ================= */

.group {
  margin-bottom: 8rpx;
}

.ghead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 6rpx 18rpx;
}

.gleft {
  display: flex;
  align-items: baseline;
}

.glabel {
  font-size: 26rpx;
  letter-spacing: 1rpx;
  color: var(--ink-2, #8b8178);
}

.glabel.dim {
  color: #b3a795;
}

.gcount {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #c0b4a5;
}

.gright {
  display: flex;
  align-items: center;
}

.gtoggle {
  font-size: 24rpx;
  color: var(--ink-2, #8b8178);
  padding: 10rpx 14rpx;
}

.gtoggle:active {
  opacity: 0.55;
}

.gdel {
  font-size: 24rpx;
  color: #b5673f;
  padding: 10rpx 4rpx 10rpx 12rpx;
}

.gdel:active {
  opacity: 0.55;
}

/* 平铺卡片外层负责间距（卡片自身的 margin 已移除，避免左滑容器把空隙算进高度） */
.flat {
  margin-bottom: 24rpx;
}

.gbody .flat:last-child {
  margin-bottom: 28rpx;
}

/* 折叠态：三张错落的卡片边缘 */
.stack {
  position: relative;
  height: 176rpx;
  margin: 0 6rpx 28rpx;
}

.layer {
  position: absolute;
  left: 0;
  right: 0;
  height: 132rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 1rpx solid #f1e8db;
}

.layer-3 {
  top: 0;
  transform: scale(0.9);
  opacity: 0.45;
}

.layer-2 {
  top: 14rpx;
  transform: scale(0.95);
  opacity: 0.72;
}

.layer-1 {
  top: 28rpx;
  padding: 22rpx 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(44, 39, 35, 0.06);
}

.peek-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.peek-badge {
  font-size: 20rpx;
  color: var(--accent, #c4713f);
  background: #f8ece0;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.peek-time {
  font-size: 20rpx;
  color: #b3a795;
}

.peek-line {
  margin-top: 16rpx;
  padding-right: 120rpx;
  font-size: 27rpx;
  line-height: 1.4;
  color: var(--ink, #2c2723);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stack-more {
  position: absolute;
  right: 28rpx;
  bottom: 18rpx;
  font-size: 20rpx;
  color: #c9bdaf;
}

/* 撤销条文字可能带分组名，压成一行省略 */
.undo-text {
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ================= 筛选条 ================= */

.chips {
  display: flex;
  flex-direction: row;
  width: 100%;
  white-space: nowrap;
  padding: 0 0 18rpx;
}

.chip {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 56rpx;
  margin-right: 14rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 1rpx solid #efe6d8;
  font-size: 24rpx;
  color: var(--ink-2, #8b8178);
}

.chip.on {
  background: #f8ece0;
  border-color: #e6c9ae;
  color: var(--accent, #c4713f);
}

.chip-star {
  margin-right: 6rpx;
  font-size: 20rpx;
}

.chip-n {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #b8ab99;
}

.chip.on .chip-n {
  color: var(--accent, #c4713f);
}

/* ================= 那年今日 ================= */

/*
 * 备份提示：一条细横幅，不是卡片。
 * 它说的是"数据会丢"，不是"内容值得看"，所以压到最薄——比下面那张
 * 回顾位矮一半，视觉上排在前面却不会抢走第一眼。
 */
.bk {
  display: flex;
  align-items: center;
  margin: 0 0 18rpx;
  padding: 14rpx 20rpx 14rpx 24rpx;
  border-radius: 16rpx;
  background: #fdf8ef;
  border: 1rpx solid var(--line, #f0e7da);
}

.bk:active {
  opacity: 0.85;
}

.bk-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
}

/* 长文案（"已记 128 条 · 只在这台手机上"）先省略，别把 tip 挤出去 */
.bk-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #8a6a44;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bk-tip {
  flex: 0 0 auto;
  margin-left: 14rpx;
  font-size: 24rpx;
  color: var(--accent, #c4713f);
}

/* 关闭区留够手指宽度，别让 × 变成一个点不中的小字 */
.bk-x {
  flex: 0 0 auto;
  margin-left: 6rpx;
  padding: 6rpx 2rpx 6rpx 18rpx;
}

.bk-xc {
  font-size: 30rpx;
  line-height: 1;
  color: #bcae9c;
}

.anni {
  margin: 2rpx 0 22rpx;
  padding: 24rpx 28rpx 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fdf3ea 0%, #faf5ec 100%);
  border: 1rpx solid #f0e2d2;
}

.anni:active {
  opacity: 0.85;
}

/* 回顾位：版式同那年今日，换成中性米色——暖橙留给"回忆"，米色留给"随手一翻" */
.anni.review {
  background: var(--beige, #f7f1e7);
  border-color: var(--line, #f0e7da);
}

/*
 * 提醒位：这一栏是"现在该做的事"，不是"回头看的东西"。
 * 用纸白底 + 左侧一道橙线，与暖橙渐变的回忆、米色的随手一翻都分开；
 * 橙色只留在左边线和 tip 上，不铺满，免得天天看成了背景噪音。
 */
.anni.nudge {
  background: var(--paper, #ffffff);
  border-color: #e8d8c4;
  padding-left: 34rpx;
  box-shadow: inset 6rpx 0 0 var(--accent, #c4713f);
}

.anni.nudge .anni-label {
  color: var(--accent, #c4713f);
  font-weight: 500;
}

.anni.nudge .anni-tip {
  color: var(--accent, #c4713f);
}

.anni-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.anni-label {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--accent, #c4713f);
}

.anni-tip {
  font-size: 22rpx;
  color: #b8ab99;
}

.anni-text {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #4a423a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ================= 多选操作条 ================= */

.selbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 45;
  display: flex;
  align-items: center;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--line, #f0e7da);
}

.sel-count {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink-2, #8b8178);
}

.sel-act {
  margin-left: 18rpx;
  padding: 12rpx 26rpx;
  border-radius: 30rpx;
  background: #f7f1e7;
  font-size: 26rpx;
  color: var(--ink, #2c2723);
}

.sel-act:active {
  opacity: 0.7;
}

.sel-act.danger {
  color: #b5673f;
  background: #faf0ea;
}
