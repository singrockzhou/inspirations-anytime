.page {
  min-height: 100vh;
  padding: 8rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
}

/* 顶部标题行 */
.top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 16rpx 4rpx 20rpx;
}

.top-left {
  display: flex;
  align-items: baseline;
}

.title {
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  color: var(--ink, #2c2723);
}

.count {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--ink-2, #8b8178);
}

.mine {
  font-size: 26rpx;
  color: var(--ink-2, #8b8178);
  padding: 8rpx 4rpx 8rpx 24rpx;
}

/* 吸顶伪输入条 */
.stick {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 4rpx 0 20rpx;
  background: var(--bg, #fbf8f3);
}

.composer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 44rpx;
  background: var(--beige, #f7f1e7);
  border: 1rpx solid #f0e5d6;
}

.composer:active {
  background: #f3ebde;
}

.composer-ph {
  font-size: 30rpx;
  color: #a2957f;
}

.composer-dot {
  font-size: 28rpx;
  color: var(--accent, #c4713f);
  opacity: 0.75;
}

/* 分组 */
.grp {
  padding: 20rpx 4rpx 14rpx;
  font-size: 24rpx;
  color: var(--ink-2, #8b8178);
  letter-spacing: 1rpx;
}

.more-hint,
.end-hint {
  padding: 12rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b3a795;
}

/* 空态 */
.empty {
  padding-top: 180rpx;
  text-align: center;
}

.empty-line {
  font-size: 36rpx;
  color: var(--ink, #2c2723);
  letter-spacing: 1rpx;
}

.empty-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--ink-2, #8b8178);
}

.empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  height: 88rpx;
  padding: 0 56rpx;
  border-radius: 44rpx;
  background: var(--accent, #c4713f);
  color: #fff;
  font-size: 30rpx;
}

.empty-btn:active {
  opacity: 0.88;
}

/* 底部三入口：等宽并排，点一下直接进 */
.entry-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: stretch;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--bg, #fbf8f3);
  border-top: 1rpx solid var(--line, #f0e7da);
}

.entry {
  flex: 1;
  height: 116rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid #f1e8db;
  box-shadow: 0 2rpx 10rpx rgba(44, 39, 35, 0.03);
  transition: transform 0.12s ease, background-color 0.12s ease;
}

/* 用 margin 而不是 gap，低版本基础库也能吃住 */
.entry + .entry {
  margin-left: 18rpx;
}

.entry-hover {
  background: #fdf4ec;
  border-color: #f0d8c3;
  transform: scale(0.97);
}

/* 拍一张是主路径，给一点颜色权重 */
.entry-key {
  background: #fdf3ea;
  border-color: #f3ddc8;
}

.entry-key .entry-tx,
.entry-key .entry-ic {
  color: var(--accent, #c4713f);
}

.entry-hover-key {
  background: #fbe9da;
  border-color: #ecc9ab;
  transform: scale(0.97);
}

.entry-ic {
  width: 48rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-light, #d0895c);
}

.entry-tx {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1;
  letter-spacing: 1rpx;
  color: var(--ink-2, #8b8178);
}

/* 图标全部用 CSS 画，不额外引图片资源 */

/* 写一句：三行字 */
.ic-text {
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding-left: 5rpx;
}

.ic-text .ln {
  height: 4rpx;
  background: currentColor;
  border-radius: 3rpx;
}

.ln-a {
  width: 38rpx;
}

.ln-b {
  width: 38rpx;
  margin: 9rpx 0;
}

.ln-c {
  width: 24rpx;
}

/* 说一段：三根波形 */
.ic-voice {
  flex-direction: row;
}

.ic-voice .bar {
  width: 4rpx;
  margin: 0 4rpx;
  background: currentColor;
  border-radius: 3rpx;
}

.bar-a {
  height: 16rpx;
}

.bar-b {
  height: 34rpx;
}

.bar-c {
  height: 24rpx;
}

/* 拍一张：相机 */
.ic-cam {
  position: relative;
}

.cam-top {
  position: absolute;
  top: 2rpx;
  left: 50%;
  margin-left: -10rpx;
  width: 20rpx;
  height: 6rpx;
  background: currentColor;
  border-radius: 3rpx 3rpx 0 0;
}

.cam-body {
  position: absolute;
  top: 8rpx;
  left: 0;
  box-sizing: border-box;
  width: 48rpx;
  height: 34rpx;
  border: 4rpx solid currentColor;
  border-radius: 9rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cam-lens {
  box-sizing: border-box;
  width: 15rpx;
  height: 15rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

/* 撤销条：浮在入口条之上 */
.undo {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  height: 104rpx;
  padding: 0 12rpx 0 32rpx;
  border-radius: 24rpx;
  background: rgba(44, 39, 35, 0.92);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 60;
  animation: undo-in 0.2s ease-out;
}

@keyframes undo-in {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.undo-text {
  font-size: 26rpx;
  color: #f6efe4;
}

.undo-btn {
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  color: var(--accent-light, #e0a472);
  font-size: 28rpx;
}

.undo-btn:active {
  background: rgba(255, 255, 255, 0.08);
}
