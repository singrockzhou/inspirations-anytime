<!-- 手势挂在整页根节点：手指落在纸、缩略图、按钮上都算，
     纵向滑动仍由内部 scroll-view 接管（横纵判定见 onTouchMove） -->
<view
  class="page"
  bindtouchstart="onTouchStart"
  bindtouchmove="onTouchMove"
  bindtouchend="onTouchEnd"
  bindtouchcancel="onTouchEnd"
>

  <view class="head">
    <text class="head-t">{{t.head}}</text>
    <text class="head-s" wx:if="{{total}}">{{headSub}}</text>
  </view>

  <block wx:if="{{item}}">
    <!-- 跟手位移只作用在纸上：标题与按钮不动，像把一张卡抽走 -->
    <view class="paper" style="transform:translateX({{swipeDx}}px);transition:{{swipeTransition}};">
      <view class="meta">
        <text class="ago">{{agoText}}<text wx:if="{{photoCount > 1}}">{{photoAlso}}</text></text>
        <text class="star" wx:if="{{starred}}">★</text>
      </view>

      <scroll-view class="body" scroll-y="true" enable-flex="true" scroll-top="{{scrollTop}}" bindscroll="onScroll">

        <!-- 照片：缩略图网格，点哪张从哪张看大图 -->
        <photo-grid wx:if="{{photos.length}}" paths="{{photos}}" single="crop" />

        <!-- 语音：按行列出，一行一条，进度就在行里走 -->
        <view class="audio-list" wx:if="{{voices.length}}">
          <view
            class="audio {{playingId === v.id ? 'on' : ''}}"
            wx:for="{{voices}}"
            wx:key="id"
            wx:for-item="v"
            catchtap="onToggleAudio"
            data-id="{{v.id}}"
          >
            <view class="audio-btn">
              <view class="ic-play" wx:if="{{playingId !== v.id || paused}}" />
              <view class="ic-pause" wx:else>
                <view class="bar" />
                <view class="bar" />
              </view>
            </view>

            <view class="audio-main">
              <view class="track">
                <view class="fill" style="width:{{playingId === v.id ? progress : 0}}%" />
              </view>
              <view class="audio-meta">
                <text class="audio-state">{{playingId === v.id ? (paused ? t.audio_paused : t.audio_playing) : t.audio_tap}}</text>
                <text class="audio-time">{{playingId === v.id ? curText : v.durText}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 正文：有图有音时退成副文，不跟缩略图抢视线 -->
        <view class="text {{photos.length || voices.length ? 'sub' : ''}}" wx:if="{{item.content}}">{{item.content}}</view>
        <view class="text dim" wx:elif="{{!photos.length && !voices.length}}">{{t.no_content}}</view>

      </scroll-view>

      <view class="tags" wx:if="{{item.tags.length}}">
        <text class="tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tg">#{{tg}}</text>
      </view>

      <view class="foot">{{timeText}}</view>
    </view>

    <view class="ops">
      <view class="op main" catchtap="onNext">{{t.op_next}}</view>
      <view class="op" catchtap="onStar">{{starred ? t.op_unstar : t.op_star}}</view>
      <view class="op" catchtap="onOpen">{{t.op_open}}</view>
    </view>

    <button class="share" open-type="share">{{t.share}}</button>
  </block>

  <view class="empty" wx:if="{{empty}}">
    <view class="empty-t">{{t.empty}}</view>
    <view class="empty-s">{{t.empty_sub}}</view>
    <view class="empty-btn" catchtap="goWrite">{{t.empty_btn}}</view>
  </view>

  <view class="toast" wx:if="{{toastText}}">{{toastText}}</view>
</view>
