.page {
  min-height: 100vh;
  padding: 48rpx 40rpx calc(80rpx + env(safe-area-inset-bottom));
}

.hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 24rpx 8rpx 40rpx;
}

.hero-main {
  display: flex;
  align-items: baseline;
}

/* 连续天数：比总数小一号，作为副信息压在右侧 */
.hero-streak {
  display: flex;
  align-items: baseline;
  padding-bottom: 10rpx;
}

.streak-num {
  font-size: 44rpx;
  color: var(--accent, #c4713f);
}

.streak-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #b3a795;
}

.hero-num {
  font-size: 96rpx;
  font-weight: 500;
  line-height: 1.1;
  color: var(--ink, #2c2723);
}

.hero-unit {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: var(--ink-2, #8b8178);
}

.block {
  background: #fff;
  border: 1rpx solid var(--line, #f0e7da);
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f7f1e8;
}

.row:last-child {
  border-bottom: none;
}

.row-k {
  font-size: 28rpx;
  color: var(--ink, #2c2723);
}

.row-v {
  font-size: 26rpx;
  color: var(--ink-2, #8b8178);
  text-align: right;
  max-width: 60%;
}

/* 该备份了：只换颜色，不加图标不加边框——这一行是状态，不是警报 */
.row-v.warn {
  color: var(--accent, #c4713f);
}

.note {
  padding: 8rpx 8rpx 56rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #a2957f;
}

/* 额度告警：和危险操作同一个赭色，但不做成按钮，避免误触 */
.storage-warn {
  margin: -8rpx 0 20rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #fdf1e9;
  border: 1rpx solid #f0dccd;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--warn, #b5673f);
}

.clear {
  height: 96rpx;
  border-radius: 48rpx;
  border: 1rpx solid #e8cfc1;
  color: var(--warn, #b5673f);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear:active {
  background: #faf0ea;
}

/* 小节标题 */
.sec {
  padding: 12rpx 8rpx 14rpx;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: #b3a795;
}

/* 可点击的整行 */
.row.tap:active {
  background: #fdfaf5;
}

.row-main {
  display: flex;
  flex-direction: column;
  padding: 18rpx 0;
}

.row-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #b3a795;
}

.row-go {
  font-size: 34rpx;
  line-height: 1;
  color: #cbbcaa;
}

.row.tap .row-k {
  font-size: 28rpx;
}

/* ================= 热力图 ================= */

.heat-block {
  padding: 28rpx 28rpx 22rpx;
}

.heat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.heat-t {
  font-size: 24rpx;
  color: var(--ink, #2c2723);
}

.heat-s {
  font-size: 22rpx;
  color: #b3a795;
}

/* 7 行 14 列：每列一周，周一在最上面，时间从左往右走 */
.heat {
  display: grid;
  grid-template-rows: repeat(7, 36rpx);
  grid-auto-flow: column;
  grid-auto-columns: 36rpx;
  gap: 8rpx;
}

/* 底色挂在 .cell 上（而不是 .heat .cell），这样图例里的格子也有底色 */
.cell {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: #f2ece2;
}

.level-1 {
  background: #f6ddc6;
}

.level-2 {
  background: #eec19b;
}

.level-3 {
  background: #dd9a68;
}

.level-4 {
  background: #c4713f;
}

.cell.future {
  background: transparent;
}

.heat-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-top: 18rpx;
}

.heat-legend .cell {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
  border-radius: 6rpx;
}

.lg {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #c0b4a5;
}

.lg:first-child {
  margin-left: 0;
}
