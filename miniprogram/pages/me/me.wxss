.page {
  min-height: 100vh;
  padding: 48rpx 40rpx calc(80rpx + env(safe-area-inset-bottom));
}

.hero {
  display: flex;
  align-items: baseline;
  padding: 24rpx 8rpx 48rpx;
}

.hero-num {
  font-size: 96rpx;
  font-weight: 500;
  line-height: 1.1;
  color: var(--ink, #2c2723);
}

.hero-unit {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: var(--ink-2, #8b8178);
}

.block {
  background: #fff;
  border: 1rpx solid var(--line, #f0e7da);
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f7f1e8;
}

.row:last-child {
  border-bottom: none;
}

.row-k {
  font-size: 28rpx;
  color: var(--ink, #2c2723);
}

.row-v {
  font-size: 26rpx;
  color: var(--ink-2, #8b8178);
  text-align: right;
  max-width: 60%;
}

.note {
  padding: 8rpx 8rpx 56rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #a2957f;
}

.clear {
  height: 96rpx;
  border-radius: 48rpx;
  border: 1rpx solid #e8cfc1;
  color: var(--warn, #b5673f);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear:active {
  background: #faf0ea;
}

/* 小节标题 */
.sec {
  padding: 12rpx 8rpx 14rpx;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: #b3a795;
}

/* 可点击的整行 */
.row.tap:active {
  background: #fdfaf5;
}

.row-main {
  display: flex;
  flex-direction: column;
  padding: 18rpx 0;
}

.row-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #b3a795;
}

.row-go {
  font-size: 34rpx;
  line-height: 1;
  color: #cbbcaa;
}

.row.tap .row-k {
  font-size: 28rpx;
}
