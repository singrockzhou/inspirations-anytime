<view class="page">

  <view class="hero">
    <view class="hero-main">
      <text class="hero-num">{{total}}</text>
      <text class="hero-unit">条灵感</text>
    </view>
    <view class="hero-streak" wx:if="{{streak > 0}}">
      <text class="streak-num">{{streak}}</text>
      <text class="streak-unit">天连续</text>
    </view>
  </view>

  <!-- 记录热力图：最近 14 周，每列一周，周一在上 -->
  <view class="block heat-block" wx:if="{{total > 0}}">
    <view class="heat-head">
      <text class="heat-t">最近 14 周</text>
      <text class="heat-s">最多一天 {{heatMax}} 条</text>
    </view>
    <view class="heat">
      <view
        class="cell level-{{item.level}} {{item.future ? 'future' : ''}}"
        wx:for="{{heat}}"
        wx:key="key"
      ></view>
    </view>
    <view class="heat-legend">
      <text class="lg">少</text>
      <view class="cell level-0"></view>
      <view class="cell level-1"></view>
      <view class="cell level-2"></view>
      <view class="cell level-3"></view>
      <view class="cell level-4"></view>
      <text class="lg">多</text>
    </view>
  </view>

  <view class="block">
    <view class="row">
      <text class="row-k">开始记录</text>
      <text class="row-v">{{firstText}}</text>
    </view>
    <view class="row">
      <text class="row-k">最近一条</text>
      <text class="row-v">{{lastText}}</text>
    </view>
    <view class="row">
      <text class="row-k">文字 / 语音 / 照片</text>
      <text class="row-v">{{byType.text}} / {{byType.voice}} / {{byType.photo}}</text>
    </view>
    <view class="row">
      <text class="row-k">加星 / 归档 / 带标签</text>
      <text class="row-v">{{starred}} / {{archived}} / {{tagged}}</text>
    </view>
  </view>

  <!-- 回顾 -->
  <view class="sec">回顾</view>
  <view class="block">
    <view class="row tap" bindtap="onReview">
      <view class="row-main">
        <text class="row-k">随便翻一条</text>
        <text class="row-sub">从旧记录里抽一条给你看</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row tap" bindtap="onArchive">
      <view class="row-main">
        <text class="row-k">归档</text>
        <text class="row-sub">收起来但仍然留着的内容</text>
      </view>
      <text class="row-v">{{archived}} 条 ›</text>
    </view>
  </view>

  <!-- 提醒 -->
  <view class="sec">习惯</view>
  <view class="block">
    <view class="row tap" bindtap="onRemind">
      <view class="row-main">
        <text class="row-k">每日提醒</text>
        <text class="row-sub">{{remindReady ? (remindOn ? '到点提醒你记一条' : '还没开') : '需要先在后台配订阅消息模板'}}</text>
      </view>
      <text class="row-v">{{remindOn ? '已开' : '关'}} ›</text>
    </view>
    <picker mode="time" value="{{remindTime}}" bindchange="onRemindTime">
      <view class="row tap">
        <view class="row-main">
          <text class="row-k">提醒时间</text>
          <text class="row-sub">记下你想被提醒的时刻</text>
        </view>
        <text class="row-v">{{remindTime}} ›</text>
      </view>
    </picker>
  </view>

  <!-- 换手机：一个文件带走，一个文件带回 -->
  <view class="sec">换手机</view>
  <view class="block">
    <view class="row tap" bindtap="onExport">
      <view class="row-main">
        <text class="row-k">导出到文件</text>
        <text class="row-sub">文字、图片、录音一起打包</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row tap" bindtap="onImport">
      <view class="row-main">
        <text class="row-k">从文件导入</text>
        <text class="row-sub">从聊天里选 .json 备份</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row tap" bindtap="onImportChat">
      <view class="row-main">
        <text class="row-k">从聊天存一条</text>
        <text class="row-sub">把聊天里的文件或图片收成灵感</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="block">
    <view class="row" bindtap="onAbout">
      <text class="row-k">关于</text>
      <text class="row-v">v{{version}}</text>
    </view>
    <view class="row tap" wx:if="{{storageText}}" bindtap="onStorage">
      <view class="row-main">
        <text class="row-k">记录索引</text>
        <text class="row-sub">文字与设置，已用 {{storagePctText}}%</text>
      </view>
      <text class="row-v">{{storageText}}</text>
    </view>
    <view class="row tap" wx:if="{{mediaText}}" bindtap="onStorage">
      <view class="row-main">
        <text class="row-k">图片与录音</text>
        <text class="row-sub">本机文件，单独计配额</text>
      </view>
      <text class="row-v">{{mediaText}}</text>
    </view>
  </view>

  <view class="storage-warn" wx:if="{{storageWarn}}" bindtap="onStorage">{{storageWarn}}</view>

  <view class="note">
    记录只存在这台手机上，不上传、不联网。换手机时先导出成文件，在新手机上导入即可。
    导入只做新增，同一条记录不会重复，也不会覆盖新手机上刚记的内容。
  </view>

  <view class="clear" bindtap="onClear">清空全部记录</view>

</view>

<!-- 统一对话框：页面内只挂一个，命令式调用见 utils/dialog.js -->
<dialog-view />
