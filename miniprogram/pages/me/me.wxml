<view class="page">

  <view class="hero">
    <view class="hero-main">
      <text class="hero-num">{{total}}</text>
      <text class="hero-unit">{{t.hero_unit}}</text>
    </view>
    <view class="hero-streak" wx:if="{{streak > 0}}">
      <text class="streak-num">{{streak}}</text>
      <text class="streak-unit">{{t.streak_unit}}</text>
    </view>
  </view>

  <!-- 记录热力图：最近 14 周，每列一周，周一在上 -->
  <view class="block heat-block" wx:if="{{total > 0}}">
    <view class="heat-head">
      <text class="heat-t">{{t.heat_title}}</text>
      <text class="heat-s">{{heatSub}}</text>
    </view>
    <view class="heat">
      <view
        class="cell level-{{item.level}} {{item.future ? 'future' : ''}}"
        wx:for="{{heat}}"
        wx:key="key"
      ></view>
    </view>
    <view class="heat-legend">
      <text class="lg">{{t.heat_less}}</text>
      <view class="cell level-0"></view>
      <view class="cell level-1"></view>
      <view class="cell level-2"></view>
      <view class="cell level-3"></view>
      <view class="cell level-4"></view>
      <text class="lg">{{t.heat_more}}</text>
    </view>
  </view>

  <view class="block">
    <view class="row">
      <text class="row-k">{{t.row_first}}</text>
      <text class="row-v">{{firstText}}</text>
    </view>
    <view class="row">
      <text class="row-k">{{t.row_last}}</text>
      <text class="row-v">{{lastText}}</text>
    </view>
    <view class="row">
      <text class="row-k">{{t.row_types}}</text>
      <text class="row-v">{{byType.text}} / {{byType.voice}} / {{byType.photo}}</text>
    </view>
    <view class="row">
      <text class="row-k">{{t.row_flags}}</text>
      <text class="row-v">{{starred}} / {{archived}} / {{tagged}}</text>
    </view>
  </view>

  <!-- 整理：回顾入口已挪到首页（回顾位），这里只留归档 -->
  <view class="sec">{{t.sec_organize}}</view>
  <view class="block">
    <view class="row tap" bindtap="onArchive">
      <view class="row-main">
        <text class="row-k">{{t.row_archive}}</text>
        <text class="row-sub">{{t.row_archive_sub}}</text>
      </view>
      <text class="row-v">{{archived}} {{t.unit_item}} ›</text>
    </view>
  </view>

  <!-- 换手机：一个文件带走，一个文件带回 -->
  <view class="sec">{{t.sec_move}}</view>
  <view class="block">
    <view class="row">
      <view class="row-main">
        <text class="row-k">{{t.row_backup}}</text>
        <text class="row-sub">{{t.row_backup_sub}}</text>
      </view>
      <text class="row-v {{backupWarn ? 'warn' : ''}}">{{backupText}}</text>
    </view>
    <view class="row tap" bindtap="onExport">
      <view class="row-main">
        <text class="row-k">{{t.row_export}}</text>
        <text class="row-sub">{{t.row_export_sub}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
    <view class="row tap" bindtap="onImport">
      <view class="row-main">
        <text class="row-k">{{t.row_import}}</text>
        <text class="row-sub">{{t.row_import_sub}}</text>
      </view>
      <text class="row-go">›</text>
    </view>
  </view>

  <view class="sec">{{t.sec_lang}}</view>
  <view class="block">
    <view class="row tap" bindtap="onLang">
      <view class="row-main">
        <text class="row-k">{{t.row_lang}}</text>
        <text class="row-sub">{{t.row_lang_sub}}</text>
      </view>
      <text class="row-v">{{langName}} ›</text>
    </view>
  </view>

  <view class="block">
    <view class="row tap" bindtap="onAbout">
      <view class="row-main">
        <text class="row-k">{{t.row_about}}</text>
        <text class="row-sub">{{t.row_about_sub}}</text>
      </view>
      <text class="row-v">v{{version}} ›</text>
    </view>
    <view class="row tap" wx:if="{{storageText}}" bindtap="onStorage">
      <view class="row-main">
        <text class="row-k">{{t.row_index}}</text>
        <text class="row-sub">{{indexSub}}</text>
      </view>
      <text class="row-v">{{storageText}}</text>
    </view>
    <view class="row tap" wx:if="{{mediaText}}" bindtap="onStorage">
      <view class="row-main">
        <text class="row-k">{{t.row_media}}</text>
        <text class="row-sub">{{t.row_media_sub}}</text>
      </view>
      <text class="row-v">{{mediaText}}</text>
    </view>
  </view>

  <view class="storage-warn" wx:if="{{storageWarn}}" bindtap="onStorage">{{storageWarn}}</view>

  <view class="note">{{t.note}}</view>

  <view class="clear" bindtap="onClear">{{t.clear}}</view>

</view>

<!-- 统一对话框：页面内只挂一个，命令式调用见 utils/dialog.js -->
<dialog-view />
