<view class="page">

  <!-- 自定义导航：取消 / 标题 / 存下，避开系统导航在深色键盘下的割裂感 -->
  <view class="nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-bar">
      <view class="nav-side" catchtap="onCancel">{{t.nav_cancel}}</view>
      <view class="nav-title">{{mode === 'edit' ? t.nav_edit : t.nav_new}}</view>
      <view class="nav-side nav-save {{canSave ? 'on' : ''}}" catchtap="onSave">{{t.nav_save}}</view>
    </view>
  </view>

  <view class="body">

    <!-- 文字 -->
    <block wx:if="{{type === 'text'}}">
      <textarea
        class="ta"
        value="{{content}}"
        maxlength="{{maxText}}"
        placeholder="{{t.ph_text}}"
        placeholder-class="ta-ph"
        auto-height
        focus="{{focus}}"
        show-confirm-bar="{{false}}"
        cursor-spacing="140"
        bindinput="onInput"
      />
      <view class="counter">{{content.length}} / {{maxText}}</view>
      <view class="tip">{{t.tip_tag}}</view>
    </block>

    <!-- 语音 -->
    <block wx:elif="{{type === 'voice'}}">
      <view class="voice-wrap">
        <view
          class="rec {{recording ? 'on' : ''}} {{canceling ? 'cancel' : ''}}"
          bindtouchstart="onVoiceTouchStart"
          bindtouchmove="onVoiceTouchMove"
          bindtouchend="onVoiceTouchEnd"
          bindtouchcancel="onVoiceTouchEnd"
          bindtap="onVoiceTap"
        >
          <text class="rec-main">{{recording ? recordClock : (mediaPath ? t.rec_redo : t.rec_hold)}}</text>
          <text class="rec-sub">{{recording ? (canceling ? t.rec_release_cancel : t.rec_release_save) : (clickMode ? t.rec_tap_start : t.rec_swipe_cancel)}}</text>
        </view>

        <!-- 边录边转时的实时文字 -->
        <view class="asr-live" wx:if="{{recording && asrPartial}}">{{asrPartial}}</view>

        <view class="hint" wx:if="{{hint}}">{{hint}}</view>

        <view class="chip" wx:if="{{mediaPath && !recording}}" catchtap="playVoice">
          {{voicePlaying ? t.voice_playing : voiceRecordedText}}
        </view>

        <view class="mode" wx:if="{{!recording}}" catchtap="toggleMode">
          {{clickMode ? t.voice_mode_hold : t.voice_mode_click}}
        </view>
      </view>

      <textarea
        class="ta ta-note"
        value="{{content}}"
        maxlength="{{maxCaption}}"
        placeholder="{{asrReady ? t.ph_asr : t.ph_voice_note}}"
        placeholder-class="ta-ph"
        auto-height
        show-confirm-bar="{{false}}"
        cursor-spacing="140"
        bindinput="onInput"
      />
    </block>

    <!-- 照片：最多 9 张 -->
    <block wx:else>
      <view class="grid" wx:if="{{photos.length}}">
        <view class="cell" wx:for="{{photos}}" wx:key="path">
          <image
            class="cell-img"
            src="{{item.path}}"
            mode="aspectFill"
            data-i="{{index}}"
            catchtap="previewMedia"
          />
          <view class="cell-x" data-i="{{index}}" catchtap="removePhoto">×</view>
        </view>

        <view class="cell cell-add" wx:if="{{photos.length < maxPhotos}}" catchtap="pickPhoto">
          <text class="add-plus">+</text>
          <text class="add-tx">{{t.add_photo}}</text>
        </view>
      </view>

      <view class="pick" wx:else catchtap="pickPhoto">
        <text class="pick-plus">+</text>
        <text class="pick-tx">{{t.pick_photo}}</text>
      </view>

      <view class="counter left" wx:if="{{photos.length}}">{{counterText}}</view>

      <textarea
        class="ta ta-note"
        value="{{content}}"
        maxlength="{{maxCaption}}"
        placeholder="{{t.ph_photo_note}}"
        placeholder-class="ta-ph"
        auto-height
        show-confirm-bar="{{false}}"
        cursor-spacing="140"
        bindinput="onInput"
      />
    </block>

  </view>

  <!-- 底部类型切换：一条记录只存一种形态 -->
  <view class="tools">
    <view class="tool {{type === 'text' ? 'on' : ''}}" data-type="text" catchtap="onTab">{{t.tab_text}}</view>
    <view class="tool {{type === 'voice' ? 'on' : ''}}" data-type="voice" catchtap="onTab">{{t.tab_voice}}</view>
    <view class="tool {{type === 'photo' ? 'on' : ''}}" data-type="photo" catchtap="onTab">{{t.tab_photo}}</view>
  </view>

  <view class="toast" wx:if="{{toastText}}">{{toastText}}</view>

</view>

<!-- 统一对话框：页面内只挂一个，命令式调用见 utils/dialog.js -->
<dialog-view />
