.page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: var(--bg, #fbf8f3);
}

/* 自定义导航 */
.nav {
  position: sticky;
  top: 0;
  z-index: 30;
  background: var(--bg, #fbf8f3);
}

.nav-bar {
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  font-size: 30rpx;
  color: var(--ink-2, #8b8178);
}

.nav-side {
  min-width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 30rpx;
  color: var(--ink-2, #8b8178);
}

.nav-side:active {
  opacity: 0.6;
}

.nav-save {
  text-align: right;
  color: #c9bdae;
}

.nav-save.on {
  color: var(--accent, #c4713f);
  font-weight: 500;
}

/* 内容区 */
.body {
  padding: 24rpx 40rpx 40rpx;
}

.ta {
  width: 100%;
  min-height: 300rpx;
  font-size: 34rpx;
  line-height: 1.7;
  color: var(--ink, #2c2723);
}

.ta-note {
  margin-top: 32rpx;
  min-height: 120rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--ink, #2c2723);
}

.ta-ph {
  color: #b0a494;
}

.counter {
  padding-top: 12rpx;
  text-align: right;
  font-size: 22rpx;
  color: #b3a795;
}

/* 语音 */
.voice-wrap {
  padding-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rec {
  width: 420rpx;
  height: 420rpx;
  border-radius: 210rpx;
  background: #fff;
  border: 1rpx solid var(--line, #f0e7da);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.16s ease-out, background 0.16s ease-out;
}

.rec.on {
  background: #f7e5d3;
  border-color: var(--accent-light, #e0a472);
  transform: scale(0.97);
}

.rec.cancel {
  background: #f1e2e0;
}

.rec-main {
  font-size: 38rpx;
  color: var(--ink, #2c2723);
  letter-spacing: 1rpx;
}

.rec.on .rec-main {
  color: var(--accent, #c4713f);
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.rec-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ink-2, #8b8178);
}

.hint {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: var(--warn, #b5673f);
}

.chip {
  margin-top: 40rpx;
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: 38rpx;
  background: #f8ece0;
  color: var(--accent, #c4713f);
  font-size: 26rpx;
  display: flex;
  align-items: center;
}

.mode {
  margin-top: 36rpx;
  font-size: 26rpx;
  color: var(--ink-2, #8b8178);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

/* 照片 */
.photo {
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
}

.photo-img {
  width: 100%;
  height: 560rpx;
}

.pick {
  height: 480rpx;
  border-radius: 24rpx;
  border: 1rpx dashed #ddcfbd;
  background: #fdfaf5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pick-plus {
  font-size: 64rpx;
  color: var(--accent-light, #e0a472);
  line-height: 1;
}

.pick-tx {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--ink-2, #8b8178);
}

.ops {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
}

.op {
  margin-left: 32rpx;
  font-size: 26rpx;
  color: var(--ink-2, #8b8178);
}

.op.danger {
  color: var(--warn, #b5673f);
}

/* 底部类型条 */
.tools {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg, #fbf8f3);
  border-top: 1rpx solid var(--line, #f0e7da);
}

.tool {
  flex: 1;
  height: 84rpx;
  margin: 0 8rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--ink-2, #8b8178);
  background: var(--beige, #f7f1e7);
}

.tool.on {
  background: var(--accent, #c4713f);
  color: #fff;
}
