<view class="page">

  <view class="stage" wx:if="{{ready}}">
    <image class="preview" src="{{imgPath}}" mode="widthFix" show-menu-by-longpress />
  </view>

  <view class="hint" wx:if="{{ready}}">{{t.hint}}</view>

  <view class="waiting" wx:if="{{!ready && !error}}">
    <view class="dot"></view>
    <text>{{t.rendering}}</text>
  </view>

  <view class="err" wx:if="{{error}}">{{error}}</view>

  <view class="ops" wx:if="{{ready}}">
    <view class="op main" catchtap="onSave">{{t.save}}</view>
    <view class="op" catchtap="onShareImage">{{t.share}}</view>
    <view class="op" catchtap="onCopy">{{t.copy}}</view>
  </view>

  <!-- 离屏画布：只用于绘制与导出，不参与布局 -->
  <canvas
    type="2d"
    id="poster"
    class="cv"
    style="width: {{cssW}}px; height: {{cssH}}px"
  ></canvas>

  <view class="toast" wx:if="{{toastText}}">{{toastText}}</view>
</view>

<!-- 统一对话框：页面内只挂一个，命令式调用见 utils/dialog.js -->
<dialog-view />
