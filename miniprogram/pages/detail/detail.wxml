<view
  class="page"
  wx:if="{{record}}"
  style="transform:translateX({{swipeDx}}px);transition:{{swipeTransition}};"
  bindtouchstart="onTouchStart"
  bindtouchmove="onTouchMove"
  bindtouchend="onTouchEnd"
  bindtouchcancel="onTouchEnd"
>

  <!-- 内容区：内容短时也贴顶，不参与撑高 -->
  <view class="main">

    <view class="head">
      <view class="badge">{{typeLabel}}</view>
      <view class="head-right">
        <text class="star {{starred ? 'on' : ''}}" catchtap="onToggleStar">{{starred ? t.star_on : t.star_off}}</text>
        <text class="time">{{timeText}}</text>
      </view>
    </view>

    <!-- 文字 -->
    <view class="text" wx:if="{{record.type === 'text'}}">{{record.content}}</view>

    <!-- 语音 -->
    <block wx:elif="{{record.type === 'voice'}}">
      <view class="player" catchtap="onPlay">
        <view class="play {{playing ? 'on' : ''}}">{{playing ? '■' : '▶'}}</view>
        <text class="dur">{{record.duration}}″</text>
        <text class="state">{{playing ? t.playing : t.tap_listen}}</text>
      </view>
      <view class="text sub" wx:if="{{record.content}}">{{record.content}}</view>
    </block>

    <!-- 照片：统一走缩略图网格（一张按原比例，多张按张数分列，最多 9 格） -->
    <block wx:else>
      <photo-grid paths="{{photos}}" single="auto" />
      <view class="text sub" wx:if="{{record.content}}">{{record.content}}</view>
    </block>

    <!-- 没有文字时，补一句就能被搜到 -->
    <view class="need-text" wx:if="{{needText}}" catchtap="onAddText">
      {{t.add_text}}
    </view>

    <!-- 标签 -->
    <view class="tags" wx:if="{{record.tags.length}}">
      <text class="tag" wx:for="{{record.tags}}" wx:key="*this" wx:for-item="tg">#{{tg}}</text>
    </view>

    <view class="meta">
      <text class="meta-line">{{metaCreated}}</text>
      <text class="meta-line" wx:if="{{updatedText}}">{{metaUpdated}}</text>
      <text class="meta-line" wx:if="{{archived}}">{{t.meta_archived}}</text>
    </view>
  </view>

  <!-- 操作区：内容短时贴底，把剩余空白收在内容与操作之间，页面底部不留空 -->
  <view class="bottom">

    <view class="actions">
      <view class="act" catchtap="onEdit">{{t.act_edit}}</view>
      <view class="act" catchtap="onCopy">{{t.act_copy}}</view>
      <view class="act" catchtap="onPoster">{{t.act_poster}}</view>
      <view class="act" catchtap="onToggleArchive">{{archived ? t.act_unarchive : t.act_archive}}</view>
      <view class="act danger" catchtap="onDelete">{{t.act_delete}}</view>
    </view>

    <button class="share" open-type="share">{{t.share}}</button>

    <!-- 左右翻：手势之外的兜底（PC 端用鼠标滑不动，箭头正好补上） -->
    <view class="flipbar" wx:if="{{total > 1}}">
      <view
        class="flip-btn {{canPrev ? '' : 'off'}}"
        hover-class="{{canPrev ? 'flip-btn-hover' : 'none'}}"
        hover-stay-time="80"
        catchtap="onPrev"
      >{{t.prev}}</view>
      <text class="flip-tip">{{t.flip_tip}}</text>
      <view
        class="flip-btn"
        hover-class="flip-btn-hover"
        hover-stay-time="80"
        catchtap="onNext"
      >{{t.next}}</view>
    </view>
  </view>

  <view class="toast" wx:if="{{toastText}}">{{toastText}}</view>
</view>

<view class="page missing" wx:if="{{missing}}">
  <text class="missing-t">{{t.missing}}</text>
  <view class="missing-btn" catchtap="goBack">{{t.back}}</view>
</view>

<!-- 统一对话框：页面内只挂一个，命令式调用见 utils/dialog.js -->
<dialog-view />
