.page {
  min-height: 100vh;
  padding: 32rpx 40rpx calc(120rpx + env(safe-area-inset-bottom));
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
}

.badge {
  font-size: 22rpx;
  color: var(--accent, #c4713f);
  background: #f8ece0;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.time {
  font-size: 22rpx;
  color: var(--ink-2, #8b8178);
}

.text {
  font-size: 34rpx;
  line-height: 1.75;
  color: var(--ink, #2c2723);
  white-space: pre-wrap;
  word-break: break-word;
}

.text.sub {
  margin-top: 32rpx;
  font-size: 30rpx;
  color: #4a423a;
}

.player {
  display: flex;
  align-items: center;
  height: 120rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid var(--line, #f0e7da);
}

.play {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--accent, #c4713f);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play.on {
  background: var(--accent-light, #e0a472);
}

.dur {
  margin-left: 24rpx;
  font-size: 30rpx;
  color: var(--ink, #2c2723);
}

.state {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--ink-2, #8b8178);
}

.photo {
  width: 100%;
  border-radius: 24rpx;
  background: var(--beige, #f7f1e7);
}

.meta {
  margin-top: 56rpx;
  display: flex;
  flex-direction: column;
}

.meta-line {
  font-size: 22rpx;
  color: #b3a795;
  line-height: 1.8;
}

.actions {
  margin-top: 64rpx;
  display: flex;
}

.act {
  flex: 1;
  height: 84rpx;
  margin: 0 8rpx;
  border-radius: 42rpx;
  border: 1rpx solid var(--line, #f0e7da);
  background: #fff;
  font-size: 28rpx;
  color: var(--ink, #2c2723);
  display: flex;
  align-items: center;
  justify-content: center;
}

.act:active {
  background: #faf5ef;
}

.act.danger {
  color: var(--warn, #b5673f);
}

.missing {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 260rpx;
}

.missing-t {
  font-size: 32rpx;
  color: var(--ink-2, #8b8178);
}

.missing-btn {
  margin-top: 40rpx;
  height: 84rpx;
  padding: 0 56rpx;
  border-radius: 42rpx;
  background: var(--accent, #c4713f);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}
