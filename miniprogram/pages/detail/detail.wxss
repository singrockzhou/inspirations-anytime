/**
 * 竖向结构：内容区贴顶、操作区贴底，中间的空隙由 auto margin 吸收。
 * 内容短的时候，剩余空白只出现在"正文"与"按钮"之间；
 * 页面最底部是一个真实存在的操作条，而不是一片什么都没有的背景。
 */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
}

.main {
  flex: 0 0 auto;
}

.bottom {
  margin-top: auto;
  padding-top: 32rpx;
  /* 一道淡线把页面切成"内容 / 操作"两段：
     内容短时那片空白就成了内容下方的留白，而不是"页面没做完" */
  border-top: 1rpx solid var(--line, #f0e7da);
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
}

.badge {
  font-size: 22rpx;
  color: var(--accent, #c4713f);
  background: #f8ece0;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.time {
  font-size: 22rpx;
  color: var(--ink-2, #8b8178);
}

.text {
  font-size: 34rpx;
  line-height: 1.75;
  color: var(--ink, #2c2723);
  white-space: pre-wrap;
  word-break: break-word;
}

.text.sub {
  margin-top: 32rpx;
  font-size: 30rpx;
  color: #4a423a;
}

.player {
  display: flex;
  align-items: center;
  height: 120rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid var(--line, #f0e7da);
}

.play {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--accent, #c4713f);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play.on {
  background: var(--accent-light, #e0a472);
}

.dur {
  margin-left: 24rpx;
  font-size: 30rpx;
  color: var(--ink, #2c2723);
}

.state {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--ink-2, #8b8178);
}

.meta {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
}

.meta-line {
  font-size: 22rpx;
  color: #b3a795;
  line-height: 1.8;
}

.actions {
  display: flex;
  flex-wrap: wrap;
}

/* 五个动作按三列排，最后一个自然落到第二行左起 */
.act {
  width: 31.4%;
  margin: 0 2.9% 16rpx 0;
  height: 84rpx;
  border-radius: 42rpx;
  border: 1rpx solid var(--line, #f0e7da);
  background: #fff;
  font-size: 28rpx;
  color: var(--ink, #2c2723);
  display: flex;
  align-items: center;
  justify-content: center;
}

.act:active {
  background: #faf5ef;
}

.act.danger {
  color: var(--warn, #b5673f);
}

.missing {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 260rpx;
}

.missing-t {
  font-size: 32rpx;
  color: var(--ink-2, #8b8178);
}

.missing-btn {
  margin-top: 40rpx;
  height: 84rpx;
  padding: 0 56rpx;
  border-radius: 42rpx;
  background: var(--accent, #c4713f);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

/* 每行第 3 个去掉右外边距 */
.act:nth-child(3n) {
  margin-right: 0;
}

/* ================= 星标 / 归档 / 补文字 ================= */

.head-right {
  display: flex;
  align-items: center;
}

.star {
  margin-right: 20rpx;
  font-size: 22rpx;
  color: #b3a795;
  padding: 6rpx 0;
}

.star.on {
  color: var(--accent, #c4713f);
}

.need-text {
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx dashed #ddcfbd;
  background: #fdfaf5;
  font-size: 24rpx;
  color: #a2957f;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 32rpx;
}

.tag {
  margin-right: 14rpx;
  margin-bottom: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #f4efe6;
  color: #8b8178;
  font-size: 22rpx;
}

/* ================= 多图（排布交给 components/photo-grid） ================= */

/* 分享按钮：抹掉原生 button 的边框与底色 */
.share {
  margin-top: 12rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: transparent;
  border: none;
  font-size: 26rpx;
  color: #a2957f;
}

.share::after {
  border: none;
}

/* ================= 左右翻一条 ================= */

/* 手势之外的兜底：PC 端用鼠标滑不动，箭头正好补上 */
.flipbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line, #f0e7da);
}

.flip-btn {
  min-width: 180rpx;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 44rpx;
  border: 1rpx solid var(--line, #f0e7da);
  background: var(--paper, #ffffff);
  color: var(--ink-2, #8b8178);
  font-size: 24rpx;
  line-height: 86rpx;
  text-align: center;
}

.flip-btn-hover {
  background: var(--beige, #f7f1e7);
}

/* 到头了：字色退一档，配合"滑不动"的阻尼一起告诉用户没有更多了 */
.flip-btn.off {
  color: #c9c0b6;
}

.flip-tip {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-2, #8b8178);
}
