/* 网格：靠百分比宽度 + 正方形盒子，任何屏宽都是齐整的方格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  /* 左右各 -4rpx，抵消格子的内边距，让最左最右与正文对齐 */
  margin: 0 -4rpx;
}

.cell {
  padding: 0 4rpx 8rpx;
}

.cell.c2 {
  width: 50%;
}

/* 两列时用 4:3 而不是 1:1：两张并排还按正方，卡片会被撑成一整屏 */
.cell.c2 .box {
  padding-top: 75%;
}

.cell.c3 {
  width: 33.3333%;
}

/* 盒子的高度 = 宽度的 100%，图片还没解码时尺寸就已经定了，列表不会跳 */
.box {
  position: relative;
  width: 100%;
  padding-top: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--beige, #f7f1e7);
}

.img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: var(--beige, #f7f1e7);
  animation: photo-in 0.18s ease-out;
}

@keyframes photo-in {
  from {
    opacity: 0.4;
  }
  to {
    opacity: 1;
  }
}

/* 单张 */
.one {
  position: relative;
  width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--beige, #f7f1e7);
}

.one.crop {
  padding-top: 66.6667%;
}

.one.crop .one-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  animation: photo-in 0.18s ease-out;
}

.one.auto .one-img {
  display: block;
  width: 100%;
  min-height: 240rpx;
  animation: photo-in 0.18s ease-out;
}

/* 文件被清掉时的占位，不留白洞也不留裂图 */
.ph {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #b8ab99;
  background: var(--beige, #f7f1e7);
}

.one.auto .ph {
  position: static;
  height: 240rpx;
}

/* 超过 9 张：最后一格压一层 +N */
.more {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(44, 39, 35, 0.62);
  color: #fff;
  font-size: 22rpx;
  line-height: 1.6;
}
