.card {
  position: relative;
  background: var(--paper, #ffffff);
  border: 1rpx solid var(--line, #f0e7da);
  border-radius: 32rpx;
  padding: 26rpx 30rpx 22rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

/* 新存下的卡片闪一次，替代"保存成功"弹窗 */
.card.fresh {
  animation: fresh 1.2s ease-out;
}

@keyframes fresh {
  0% {
    background: #f6e5d5;
  }
  100% {
    background: #ffffff;
  }
}

.card:active {
  background: #fdfaf6;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.badge {
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--accent, #c4713f);
  background: #f8ece0;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.meta {
  display: flex;
  align-items: center;
}

.flag {
  font-size: 22rpx;
  color: var(--ink-2, #8b8178);
  background: var(--beige, #f7f1e7);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
}

.time {
  font-size: 22rpx;
  color: var(--ink-2, #8b8178);
}

.body {
  font-size: 32rpx;
  line-height: 1.65;
  color: var(--ink, #2c2723);
  word-break: break-word;
  white-space: pre-wrap;
}

.body.clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
}

.body.sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #4a423a;
}

.clamp2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.fold {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--accent, #c4713f);
}

/* 语音 */
.voice {
  display: flex;
  align-items: center;
  height: 72rpx;
}

.wave {
  display: flex;
  align-items: center;
  height: 48rpx;
  margin-right: 16rpx;
}

.wave .bar {
  width: 6rpx;
  height: 20rpx;
  margin-right: 6rpx;
  border-radius: 4rpx;
  background: var(--accent, #c4713f);
  opacity: 0.5;
}

.wave .bar:nth-child(2) {
  height: 34rpx;
}

.wave .bar:nth-child(3) {
  height: 24rpx;
}

.wave .bar:nth-child(4) {
  height: 38rpx;
}

.wave .bar:nth-child(5) {
  height: 16rpx;
}

.wave.on .bar {
  opacity: 1;
  animation: wave 0.9s ease-in-out infinite;
}

.wave.on .bar:nth-child(2) {
  animation-delay: 0.12s;
}

.wave.on .bar:nth-child(3) {
  animation-delay: 0.24s;
}

.wave.on .bar:nth-child(4) {
  animation-delay: 0.36s;
}

.wave.on .bar:nth-child(5) {
  animation-delay: 0.48s;
}

@keyframes wave {
  0%,
  100% {
    transform: scaleY(1);
  }
  50% {
    transform: scaleY(2);
  }
}

.voice-dur {
  font-size: 28rpx;
  color: var(--ink, #2c2723);
}

.voice-tip {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--ink-2, #8b8178);
}

/* 照片 */
.photo {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  background: var(--beige, #f7f1e7);
}
