.card {
  position: relative;
  background: var(--paper, #ffffff);
  border: 1rpx solid var(--line, #f0e7da);
  border-radius: 32rpx;
  padding: 26rpx 30rpx 22rpx;
  overflow: hidden;
}

/* 新存下的卡片闪一次，替代"保存成功"弹窗 */
.card.fresh {
  animation: fresh 1.2s ease-out;
}

@keyframes fresh {
  0% {
    background: #f6e5d5;
  }
  100% {
    background: #ffffff;
  }
}

.card:active {
  background: #fdfaf6;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.badge {
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--accent, #c4713f);
  background: #f8ece0;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.meta {
  display: flex;
  align-items: center;
}

.flag {
  font-size: 22rpx;
  color: var(--ink-2, #8b8178);
  background: var(--beige, #f7f1e7);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
}

.time {
  font-size: 22rpx;
  color: var(--ink-2, #8b8178);
}

.body {
  font-size: 32rpx;
  line-height: 1.65;
  color: var(--ink, #2c2723);
  word-break: break-word;
  white-space: pre-wrap;
}

.body.clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
}

.body.sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #4a423a;
}

.clamp2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.fold {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--accent, #c4713f);
}

/* 语音 */
.voice {
  display: flex;
  align-items: center;
  height: 72rpx;
}

.wave {
  display: flex;
  align-items: center;
  height: 48rpx;
  margin-right: 16rpx;
}

.wave .bar {
  width: 6rpx;
  height: 20rpx;
  margin-right: 6rpx;
  border-radius: 4rpx;
  background: var(--accent, #c4713f);
  opacity: 0.5;
}

.wave .bar:nth-child(2) {
  height: 34rpx;
}

.wave .bar:nth-child(3) {
  height: 24rpx;
}

.wave .bar:nth-child(4) {
  height: 38rpx;
}

.wave .bar:nth-child(5) {
  height: 16rpx;
}

.wave.on .bar {
  opacity: 1;
  animation: wave 0.9s ease-in-out infinite;
}

.wave.on .bar:nth-child(2) {
  animation-delay: 0.12s;
}

.wave.on .bar:nth-child(3) {
  animation-delay: 0.24s;
}

.wave.on .bar:nth-child(4) {
  animation-delay: 0.36s;
}

.wave.on .bar:nth-child(5) {
  animation-delay: 0.48s;
}

@keyframes wave {
  0%,
  100% {
    transform: scaleY(1);
  }
  50% {
    transform: scaleY(2);
  }
}

.voice-dur {
  font-size: 28rpx;
  color: var(--ink, #2c2723);
}

.voice-tip {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--ink-2, #8b8178);
}

/* 照片 */
.photo {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  background: var(--beige, #f7f1e7);
}

/* ---------------- 星标 / 标签 / 多图 / 多选 ---------------- */

.star {
  font-size: 22rpx;
  color: var(--accent, #c4713f);
  margin-right: 10rpx;
}

.photo-wrap {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
}

.photo-n {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(44, 39, 35, 0.55);
  color: #fff;
  font-size: 20rpx;
  line-height: 1.6;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  margin-right: 12rpx;
  margin-bottom: 6rpx;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  background: #f4efe6;
  color: #8b8178;
  font-size: 22rpx;
  line-height: 1.7;
}

.tag.more {
  background: transparent;
  color: #b8ab99;
  padding-left: 0;
}

/* 多选：左侧留出勾选位，勾中后整卡描边 */
.card.picking {
  padding-left: 84rpx;
}

.pick-dot {
  position: absolute;
  left: 26rpx;
  top: 32rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  border: 2rpx solid #dccfbe;
  box-sizing: border-box;
}

.pick-dot.on {
  background: var(--accent, #c4713f);
  border-color: var(--accent, #c4713f);
}

.pick-dot.on::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 6rpx;
  width: 8rpx;
  height: 15rpx;
  border-right: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(40deg);
}

.card.picked {
  border-color: #e2b58f;
  background: #fdf7f0;
}
